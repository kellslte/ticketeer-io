NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://ticketeer:ticketeer@localhost:5433/ticketeer
JWT_SECRET=change-me-to-at-least-32-random-characters
JWT_EXPIRES_IN=15m
CORS_ORIGINS=http://localhost:3000
# Set when running behind a reverse proxy/load balancer (number of hops, or e.g. "loopback, 10.0.0.0/8").
# Leave unset otherwise: trusting X-Forwarded-For without a proxy lets clients spoof their IP.
TRUST_PROXY=

# Seed script only
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too

# Written by `npx @nestjs/observe link`
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
