NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://ticketeer:ticketeer@localhost:5433/ticketeer
JWT_SECRET=change-me-to-at-least-32-random-characters
JWT_EXPIRES_IN=15m
CORS_ORIGINS=http://localhost:3000
# Public base URL used in emailed links.
APP_URL=http://localhost:3000

# Local dev: mailtrap-local (brew install mailtrap-local && brew services start mailtrap-local), inbox at http://127.0.0.1:3550.
SMTP_HOST=127.0.0.1
SMTP_PORT=3535

# Mailtrap cloud (used when SMTP_HOST is unset). Unset token = emails are logged only.
# Set MAILTRAP_INBOX_ID to use the sandbox inbox.
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=
MAIL_FROM=noreply@ticketeer.io
# Set when running behind a reverse proxy/load balancer (number of hops, or e.g. "loopback, 10.0.0.0/8").
# Leave unset otherwise: trusting X-Forwarded-For without a proxy lets clients spoof their IP.
TRUST_PROXY=

# Seed script only
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too

# Written by `npx @nestjs/observe link`
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
