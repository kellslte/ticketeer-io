<!-- Verification Hero Icon & Heading -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 24px;">
  <tr>
    <td align="left">
      <div style="display: inline-block; width: 44px; height: 44px; border-radius: 10px; background-color: #EEF2FF; border: 1px solid #C7D2FE; text-align: center; line-height: 44px; margin-bottom: 16px;">
        <span style="font-size: 20px;">✉️</span>
      </div>
      <h1 style="margin: 0 0 8px 0; font-size: 22px; font-weight: 700; color: #0F172A; letter-spacing: -0.02em;">
        Confirm your email address
      </h1>
      <p style="margin: 0; font-size: 15px; line-height: 24px; color: #475569;">
        Hi <strong>{{name}}</strong>, welcome to Ticketeer! Please verify your email address to activate your account and start managing or submitting support tickets.
      </p>
    </td>
  </tr>
</table>

<!-- Primary CTA Button -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 28px 0;">
  <tr>
    <td align="center">
      <!--[if mso]>
      <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{{verifyUrl}}}" style="height:48px;v-text-anchor:middle;width:240px;" arcsize="18%" stroke="f" fillcolor="#4F46E5">
        <w:anchorlock/>
        <center style="color:#ffffff;font-family:Arial,sans-serif;font-size:15px;font-weight:bold;">Verify Email Address</center>
      </v:roundrect>
      <![endif]-->
      <!--[if !mso]><!-->
      <a href="{{{verifyUrl}}}" target="_blank" class="btn-primary" style="display: inline-block; background: linear-gradient(135deg, #4F46E5 0%, #4338CA 100%); background-color: #4F46E5; color: #FFFFFF; font-size: 15px; font-weight: 600; text-decoration: none; padding: 14px 32px; border-radius: 8px; box-shadow: 0 4px 6px -1px rgba(79, 70, 229, 0.25), 0 2px 4px -2px rgba(79, 70, 229, 0.15); text-align: center; letter-spacing: 0.01em;">
        Verify Email Address &rarr;
      </a>
      <!--<![endif]-->
    </td>
  </tr>
</table>

<!-- Expiration Notice Callout -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #FEF3C7; border: 1px solid #FDE68A; border-radius: 8px; margin-bottom: 24px;">
  <tr>
    <td style="padding: 12px 16px;">
      <p style="margin: 0; font-size: 13px; color: #92400E; line-height: 18px;">
        ⏳ <strong>Time-sensitive:</strong> This verification link will expire in <strong>{{#if expiresInHours}}{{expiresInHours}}{{else}}24{{/if}} hours</strong>.
      </p>
    </td>
  </tr>
</table>

<!-- Fallback URL Well -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #F8FAFC; border: 1px dashed #CBD5E1; border-radius: 8px; margin-bottom: 24px;">
  <tr>
    <td style="padding: 14px 16px;">
      <p style="margin: 0 0 6px 0; font-size: 12px; color: #64748B; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">
        Button not working? Copy and paste this link:
      </p>
      <p style="margin: 0; font-size: 12px; color: #4F46E5; word-break: break-all; font-family: ui-monospace, Menlo, monospace; line-height: 18px;">
        <a href="{{{verifyUrl}}}" style="color: #4F46E5; text-decoration: underline;">{{{verifyUrl}}}</a>
      </p>
    </td>
  </tr>
</table>

<p style="margin: 0; font-size: 13px; line-height: 20px; color: #94A3B8;">
  If you did not register for an account with Ticketeer, you can safely ignore this email. No action is required.
</p>
