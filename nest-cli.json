{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "modules/notifications/templates/views/**/*",
        "outDir": "dist/src"
      }
    ],
    "plugins": [{ "name": "@nestjs/swagger", "options": { "introspectComments": true } }]
  }
}
